{
  "manifest_version": 3,
  "name": "Rebban Timer",
  "version": "1.4.5",
  "description": "Start and stop your Rebban timer, draft proposals, save leads, and see money alerts from Chrome.",
  "action": {
    "default_title": "Rebban",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Start or stop the Rebban timer"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://app.rebban.com/*",
    "https://*.rebban.com/*",
    "https://cvqcanrdvtzovbmfhiwz.supabase.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
